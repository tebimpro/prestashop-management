#!/usr/bin/env bash
#
# © Tebim sp. z o.o. | tebim.pro — BSD-2-Clause
#
# psctl — control a PrestaShop store via the legacy Webservice API.
# Pure bash + curl (+ optional xmllint for pretty XML). macOS (bash 3.2) & Linux.
#
# Auth model: the webservice KEY is the HTTP Basic Auth username, empty password.
# The API speaks XML (its native, authoritative format — PrestaShop's JSON output
# is incomplete/unreliable, so this tool uses XML throughout).
#
# Credentials come from the plugin userConfig fields PRESTASHOP_URL + PRESTASHOP_TOKEN
# (injected as CLAUDE_PLUGIN_OPTION_*). Plain PRESTASHOP_* env works too for standalone
# CLI; an interactive prompt is the last resort. The /api suffix is added for you.
#
# The token is NEVER printed; PSCTL_DEBUG=1 shows the curl line with it masked.
#
set -euo pipefail

PROG="psctl"

die()  { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n'        "$PROG" "$*" >&2; }

command -v curl >/dev/null 2>&1 || die "missing dependency: curl"
HAVE_XMLLINT=0; command -v xmllint >/dev/null 2>&1 && HAVE_XMLLINT=1

# Credentials come from the plugin userConfig fields, injected as CLAUDE_PLUGIN_OPTION_*.
# Plain PRESTASHOP_* env is accepted as an alias for standalone/CLI use.
PS_URL="${CLAUDE_PLUGIN_OPTION_PRESTASHOP_URL:-${PRESTASHOP_URL:-}}"
PS_TOKEN="${CLAUDE_PLUGIN_OPTION_PRESTASHOP_TOKEN:-${PRESTASHOP_TOKEN:-}}"

# --- config resolution -----------------------------------------------------

prompt_config() {
  [ -t 0 ] || die "no credentials (plugin config / env) and stdin is not a TTY to prompt"
  if [ -z "$PS_URL" ];   then printf 'PrestaShop URL: '          >&2; IFS= read -r  PS_URL; fi
  if [ -z "$PS_TOKEN" ]; then printf 'Webservice key (hidden): ' >&2; IFS= read -rs PS_TOKEN; printf '\n' >&2; fi
}

normalize_base() {
  # strip trailing slash, ensure single /api suffix
  local u="${1%/}"
  case "$u" in */api) : ;; *) u="$u/api" ;; esac
  printf '%s' "$u"
}

ensure_config() {
  if [ -z "$PS_URL" ] || [ -z "$PS_TOKEN" ]; then prompt_config; fi
  [ -n "$PS_URL" ]   || die "missing PRESTASHOP_URL (set it in the plugin config)"
  [ -n "$PS_TOKEN" ] || die "missing PRESTASHOP_TOKEN (set it in the plugin config) — see: psctl token-help"
  PS_URL=$(normalize_base "$PS_URL")
}

mask() {
  local t="$1" n=${#1}
  if [ "$n" -le 6 ]; then printf '******'; else printf '%s****%s' "${t:0:4}" "${t:$((n-2))}"; fi
}

# Byte-wise urlencoder (LC_ALL=C makes bash iterate bytes, so UTF-8 such as
# "żółw" encodes correctly as %C5%BC%C3%B3%C5%82w).
urlencode() {
  local LC_ALL=C
  local s="$1" out="" c i
  for (( i=0; i<${#s}; i++ )); do
    c=${s:$i:1}
    case "$c" in
      [a-zA-Z0-9._~=,\[\]-]) out+="$c" ;;
      *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

build_query() {
  # Each arg is "key=value" passed verbatim to the webservice (key kept raw so
  # filter[field] survives; value url-encoded). No output_format: responses are
  # XML, PrestaShop's native/authoritative format (its JSON output is unreliable).
  local q="" p k v sep=""
  for p in "$@"; do
    k=${p%%=*}; v=${p#*=}
    if [ "$k" = "$p" ]; then q="$q$sep$(urlencode "$p")"; else q="$q$sep$k=$(urlencode "$v")"; fi
    sep="&"
  done
  printf '%s' "$q"
}

# --- audit & http ----------------------------------------------------------

LOG_DIR="${PSCTL_LOG_DIR:-.psctl}"

is_mutation() { case "$1" in POST|PUT|DELETE|PATCH) return 0 ;; *) return 1 ;; esac; }

audit_log() { # method path code snapshot-file
  mkdir -p "$LOG_DIR"
  printf '%s\t%s\t%s\tHTTP=%s\tsnapshot=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "${4:--}" >> "$LOG_DIR/audit.log"
}

# Fetch the current record as XML BEFORE a PUT/DELETE so the change is reversible
# (restore with: psctl update <resource> <id> -f <snapshot>). Prints the file or "-".
snapshot() { # method path
  is_mutation "$1" && [ "$1" != "POST" ] || { printf '%s' "-"; return; }
  mkdir -p "$LOG_DIR/snapshots"
  local safe f
  safe=$(printf '%s' "$2" | tr '/ ' '__')
  f="$LOG_DIR/snapshots/$(date -u +%Y%m%dT%H%M%SZ)-$safe.xml"
  if curl -sS -u "$PS_TOKEN:" "$PS_URL/${2#/}" -o "$f" 2>/dev/null && [ -s "$f" ]; then
    printf '%s' "$f"
  else
    rm -f "$f"; printf '%s' "-"
  fi
}

http() {
  local method="$1" path="$2" query="${3:-}"
  shift 3
  local url="$PS_URL/${path#/}"
  [ -n "$query" ] && url="$url?$query"
  if [ "${PSCTL_DEBUG:-0}" = "1" ]; then
    warn "curl -u $(mask "$PS_TOKEN"): -X $method '$url' $*"
  fi
  if is_mutation "$method" && [ "${PSCTL_DRY_RUN:-0}" = "1" ]; then
    warn "[dry-run] $method $url (not executed)"
    return 0
  fi
  local snap="-"
  is_mutation "$method" && snap=$(snapshot "$method" "$path")
  local code tmp; tmp=$(mktemp)
  code=$(curl -sS -u "$PS_TOKEN:" -X "$method" -w '%{http_code}' -o "$tmp" "$url" "$@") \
    || { rm -f "$tmp"; die "curl request failed"; }
  local body; body=$(cat "$tmp"); rm -f "$tmp"
  is_mutation "$method" && audit_log "$method" "$path" "$code" "$snap"
  if [ "$code" -ge 400 ]; then
    printf '%s\n' "$body" >&2
    die "HTTP $code"
  fi
  if [ "$HAVE_XMLLINT" = "1" ]; then printf '%s' "$body" | xmllint --format - 2>/dev/null || printf '%s\n' "$body"
  else printf '%s\n' "$body"; fi
}

read_body() {
  local f=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f)  f="$2"; shift 2 ;;
      -f*) f="${1#-f}"; shift ;;
      *)   shift ;;
    esac
  done
  if [ -n "$f" ]; then cat "$f"; else cat; fi
}

# --- commands --------------------------------------------------------------

cmd_ping() {
  ensure_config
  warn "pinging $PS_URL ..."
  http GET "" "$(build_query)" >/dev/null && printf 'OK — authenticated, webservice reachable.\n'
}

cmd_resources() { ensure_config; http GET "" "$(build_query "$@")"; }

cmd_get() {
  ensure_config
  [ $# -ge 1 ] || die "usage: get <resource> [id] [key=value ...]"
  local resource="$1"; shift
  local id=""
  if [ $# -ge 1 ] && printf '%s' "$1" | grep -qE '^[0-9]+$'; then id="$1"; shift; fi
  local path="$resource"; [ -n "$id" ] && path="$resource/$id"
  http GET "$path" "$(build_query "$@")"
}

cmd_schema() {
  ensure_config
  [ $# -ge 1 ] || die "usage: schema <resource> [blank|synopsis]"
  http GET "$1" "$(build_query "schema=${2:-blank}")"
}

cmd_create() {
  ensure_config
  [ $# -ge 1 ] || die "usage: create <resource> [-f file.xml]   (XML body, or via stdin)"
  local r="$1"; shift
  http POST "$r" "$(build_query)" --data-binary "$(read_body "$@")" -H 'Content-Type: text/xml'
}

cmd_update() {
  ensure_config
  [ $# -ge 2 ] || die "usage: update <resource> <id> [-f file.xml]   (XML body, or via stdin)"
  local r="$1" id="$2"; shift 2
  http PUT "$r/$id" "$(build_query)" --data-binary "$(read_body "$@")" -H 'Content-Type: text/xml'
}

cmd_delete() {
  ensure_config
  [ $# -ge 2 ] || die "usage: delete <resource> <id>"
  http DELETE "$1/$2" "$(build_query)"
}

cmd_raw() {
  ensure_config
  [ $# -ge 2 ] || die "usage: raw <METHOD> <path> [curl args...]"
  local m="$1" p="$2"; shift 2
  http "$m" "${p#/}" "" "$@"
}

cmd_audit() {
  local n="${1:-20}" f="$LOG_DIR/audit.log"
  [ -f "$f" ] || die "no audit log at $f (no mutations recorded yet)"
  tail -n "$n" "$f"
}

cmd_token_help() {
  local base="${PRESTASHOP_URL:-$PS_URL}"
  base="${base%/}"; base="${base%/api}"
  cat <<EOF
Create a PrestaShop Webservice key:

  1. Log into the back office:  ${base:-https://your-shop}/admin (your admin folder)
  2. Advanced Parameters -> Webservice
  3. Set "Enable PrestaShop's webservice" = Yes, save.
  4. "Add new webservice key" -> Generate a key.
  5. Under Permissions, tick ONLY the resources + methods you need
     (GET to read, POST/PUT/DELETE to write). Least privilege.
  6. Save. Copy the generated key.

Then put it in the plugin config fields:
  - PRESTASHOP_URL   = ${base:-https://your-shop}
  - PRESTASHOP_TOKEN = THEKEY   (marked sensitive — stored securely by the host)

For a standalone CLI run you can instead export:
  export PRESTASHOP_URL=${base:-https://your-shop}
  export PRESTASHOP_TOKEN=THEKEY

Verify:  psctl ping
EOF
}

usage() {
  cat <<EOF
$PROG — control a PrestaShop store via the legacy Webservice API (XML).

Usage:
  $PROG ping                            check auth + reachability
  $PROG resources [key=value ...]       list all available API resources
  $PROG get <resource> [id] [key=val..] read (list or one record)
  $PROG schema <resource> [blank|synopsis]
  $PROG create <resource> [-f file.xml] create (XML body or stdin)
  $PROG update <resource> <id> [-f f]   update (XML body or stdin)
  $PROG delete <resource> <id>          delete
  $PROG raw <METHOD> <path> [curl..]    escape hatch
  $PROG audit [N]                       show the last N mutations (default 20)
  $PROG token-help                      how to create & provide a key

Query params are PrestaShop webservice params, passed verbatim, e.g.:
  $PROG get products display=full limit=5
  $PROG get products 'filter[active]=1' 'display=[id,reference,price]' 'sort=[id_DESC]'
  $PROG get orders 42

Responses are XML (pretty-printed via xmllint if present).
Config: plugin userConfig PRESTASHOP_URL + PRESTASHOP_TOKEN (sensitive); prompt fallback.
Debug the request line (token masked):  PSCTL_DEBUG=1 $PROG ...
Preview mutations without sending:      PSCTL_DRY_RUN=1 $PROG ...
Every POST/PUT/DELETE is logged to \$PSCTL_LOG_DIR (default ./.psctl/);
PUT/DELETE also snapshot the prior record as XML for rollback.
EOF
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  local cmd="$1"; shift
  case "$cmd" in
    ping|test)        cmd_ping "$@" ;;
    resources)        cmd_resources "$@" ;;
    get|list)         cmd_get "$@" ;;
    schema)           cmd_schema "$@" ;;
    create|add)       cmd_create "$@" ;;
    update|edit)      cmd_update "$@" ;;
    delete|rm)        cmd_delete "$@" ;;
    raw)              cmd_raw "$@" ;;
    audit)            cmd_audit "$@" ;;
    token-help|token) cmd_token_help ;;
    -h|--help|help)   usage ;;
    *)                die "unknown command: $cmd (try: $PROG help)" ;;
  esac
}

# Allow selftest to source functions without running the CLI.
[ "${PSCTL_LIB:-0}" = "1" ] || main "$@"
